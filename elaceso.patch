+"""CPU contract tests for Project Pactum agent lifecycle compatibility.
+
+The production modules import torch and etcd.  These tests execute only the
+small lifecycle helpers from their AST so they also run on review machines
+without those dependencies.
+"""
+import ast
+from pathlib import Path
+import types
+import unittest
+
+
+_ROOT = Path(__file__).resolve().parents[1]
+_AGENT_PATH = _ROOT / "bamboo/project_pactum/agent/api.py"
+_RUN_PATH = _ROOT / "bamboo/project_pactum/run/api.py"
+
+
+def _tree(path):
+    return ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+
+
+def _method(path, class_name, method_name, namespace):
+    tree = _tree(path)
+    class_node = next(
+        node for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == class_name
+    )
+    method_node = next(
+        node for node in class_node.body
+        if isinstance(node, ast.FunctionDef) and node.name == method_name
+    )
+    method_node.decorator_list = []
+    module = ast.Module(body=[method_node], type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace[method_name], method_node
+
+
+def _function(path, function_name, namespace):
+    tree = _tree(path)
+    function_node = next(
+        node for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == function_name
+    )
+    function_node.decorator_list = []
+    module = ast.Module(body=[function_node], type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace[function_name], function_node
+
+
+class _RunResult:
+    def __init__(self, state):
+        self.state = state
+
+    def is_failed(self):
+        return self.state == "FAILED"
+
+
+class _Logger:
+    def __init__(self):
+        self.messages = []
+
+    def info(self, *args):
+        self.messages.append(args)
+
+    def warning(self, *args):
+        self.messages.append(args)
+
+
+class AgentPlannedRemovalTests(unittest.TestCase):
+    def setUp(self):
+        self.states = types.SimpleNamespace(STOPPED="STOPPED")
+        self.logger = _Logger()
+
+    def test_planned_removal_returns_stopped_run_result(self):
+        stop_for_removal, _ = _method(
+            _AGENT_PATH,
+            "ProjectPactumAgent",
+            "_stop_for_planned_removal",
+            {
+                "RunResult": _RunResult,
+                "WorkerState": self.states,
+                "log": self.logger,
+            },
+        )
+        group = types.SimpleNamespace(group_rank=4, state="HEALTHY")
+        calls = []
+        agent = types.SimpleNamespace(
+            _worker_group=group,
+            _stop_workers=lambda: calls.append("stop"),
+        )
+
+        result = stop_for_removal(agent, "default")
+
+        self.assertEqual(calls, ["stop"])
+        self.assertEqual(group.state, self.states.STOPPED)
+        self.assertEqual(result.state, self.states.STOPPED)
+        self.assertFalse(result.is_failed())
+
+    def test_stopped_workers_skip_incompatible_base_event_inference(self):
+        record_events, _ = _method(
+            _AGENT_PATH,
+            "ProjectPactumAgent",
+            "_record_worker_events",
+            {"RunResult": _RunResult, "WorkerState": self.states},
+        )
+        self.assertIsNone(
+            record_events(object(), _RunResult(self.states.STOPPED))
+        )
+
+    def test_invoke_run_no_longer_returns_none_for_planned_removal(self):
+        _, method_node = _method(
+            _AGENT_PATH,
+            "ProjectPactumAgent",
+            "_invoke_run",
+            {
+                "DEFAULT_ROLE": "default",
+                "RunResult": _RunResult,
+            },
+        )
+        source = ast.get_source_segment(
+            _AGENT_PATH.read_text(encoding="utf-8"), method_node
+        )
+        self.assertIn("return self._stop_for_planned_removal(role)", source)
+        self.assertNotIn("return None", source)
+
+
+class LauncherFailureEventTests(unittest.TestCase):
+    def _load_helper(self, recorder, construct_event=None):
+        logger = _Logger()
+        events = types.SimpleNamespace(record=recorder)
+        helper, _ = _function(
+            _RUN_PATH,
+            "_record_failure_event",
+            {
+                "ProjectPactumLaunchConfig": object,
+                "events": events,
+                "logger": logger,
+                "_construct_event": construct_event or (
+                    lambda config, state=None: (config, state)
+                ),
+            },
+        )
+        return helper, logger
+
+    def test_uses_supported_agent_failure_event_api(self):
+        recorded = []
+        helper, _ = self._load_helper(recorded.append)
+        agent = types.SimpleNamespace(get_event_failed=lambda: "agent-event")
+
+        helper(agent, object())
+
+        self.assertEqual(recorded, ["agent-event"])
+
+    def test_falls_back_to_launcher_event_without_agent_api(self):
+        recorded = []
+        helper, _ = self._load_helper(recorded.append)
+        config = object()
+
+        helper(object(), config)
+
+        self.assertEqual(recorded, [(config, "FAILED")])
+
+    def test_telemetry_failure_is_best_effort(self):
+        def fail_to_record(event):
+            raise RuntimeError("telemetry unavailable")
+
+        helper, logger = self._load_helper(fail_to_record)
+
+        self.assertIsNone(helper(None, object()))
+        self.assertTrue(logger.messages)
+
+    def test_launch_agent_preserves_the_original_exception(self):
+        source = _RUN_PATH.read_text(encoding="utf-8")
+        self.assertNotIn("get_agent_status_event", source)
+        tree = _tree(_RUN_PATH)
+        launch_agent = next(
+            node for node in tree.body
+            if isinstance(node, ast.FunctionDef) and node.name == "launch_agent"
+        )
+        generic_handlers = [
+            node for node in ast.walk(launch_agent)
+            if isinstance(node, ast.ExceptHandler)
+            and isinstance(node.type, ast.Name)
+            and node.type.id == "Exception"
+        ]
+        handler = generic_handlers[-1]
+        self.assertIsInstance(handler.body[-1], ast.Raise)
+        self.assertIsNone(handler.body[-1].exc)
+        handler_source = ast.get_source_segment(source, handler)
+        self.assertIn("_record_failure_event(agent, config)", handler_source)
+
+
+if __name__ == "__main__":
+    unittest.main()
