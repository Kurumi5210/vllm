+    def _state_still_owns_lease(self, state, version, lease_key):
+        try:
+            state_version = int(state.get("version"))
+        except (TypeError, ValueError):
+            return False
+        return (
+            state.get("status") == "final"
+            and state_version == version
+            and lease_key in (state.get("keep_alives") or [])
+        )
+
+    def _missing_keep_alive_candidates(self, state, version):
+        alive_members = self.client.get(
+            self.get_path("/rdzv/v_{}".format(version))
+        )
+        alive_keys = {
+            child.key for child in getattr(alive_members, "children", [])
+        }
+        candidates = []
+        for lease_key in state.get("keep_alives") or []:
+            match = self.rank_pattern.match(lease_key)
+            if match is None or int(match.group(1)) != version:
+                log.error(
+                    "Ignoring malformed or stale keep-alive key %s in "
+                    "rendezvous version %s",
+                    lease_key,
+                    version,
+                )
+                continue
+            if lease_key not in alive_keys:
+                candidates.append((int(match.group(2)), lease_key))
+        return sorted(candidates)
