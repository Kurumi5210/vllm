+"""CPU unit tests for project_pactum.rendezvous.rank_mapping.
+
+Invoked by Aceso/experiments/correctness/run_cpu_tests.sh as
+``python3 -m unittest tests/test_rank_mapping.py``.  The module is loaded by
+path so that the test needs neither torch nor etcd.
+"""
+import importlib.util
+from pathlib import Path
+import unittest
+
+_PATH = Path(__file__).resolve().parents[1] / (
+    "bamboo/project_pactum/rendezvous/rank_mapping.py"
+)
+_SPEC = importlib.util.spec_from_file_location("rank_mapping", _PATH)
+rank_mapping = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(rank_mapping)
+build_worker_rank_mapping = rank_mapping.build_worker_rank_mapping
+should_start_scale_out = rank_mapping.should_start_scale_out
+
+
+class BuildWorkerRankMappingTests(unittest.TestCase):
+    def test_one_gpu_per_agent_scale_in(self):
+        # The LivePipe single-node scripts run one agent per GPU; losing agent
+        # 4 of 8 must remove exactly one worker rank.
+        mapping, alive = build_worker_rank_mapping(8, 4, local_world_size=1)
+        self.assertEqual(alive, 7)
+        self.assertEqual(
+            [mapping[rank] for rank in range(8)], [0, 1, 2, 3, -1, 4, 5, 6]
+        )
+
+    def test_four_gpus_per_agent_scale_in(self):
+        # The original hard-coded layout: one dead agent removes four workers.
+        mapping, alive = build_worker_rank_mapping(5, 1, local_world_size=4)
+        self.assertEqual(alive, 16)
+        self.assertEqual([mapping[r] for r in range(4)], [0, 1, 2, 3])
+        self.assertEqual([mapping[r] for r in range(4, 8)], [-1] * 4)
+        self.assertEqual([mapping[r] for r in range(8, 20)], list(range(4, 16)))
+
+    def test_surviving_ranks_are_dense_and_ordered(self):
+        for failed in range(8):
+            mapping, alive = build_worker_rank_mapping(8, failed, 1)
+            survivors = [new for old, new in sorted(mapping.items()) if new >= 0]
+            self.assertEqual(survivors, list(range(alive)))
+
+    def test_scale_out_is_identity(self):
+        mapping, alive = build_worker_rank_mapping(
+            7, None, local_world_size=1, num_nodes_waiting=1
+        )
+        self.assertEqual(alive, 8)
+        self.assertEqual(mapping, {rank: rank for rank in range(8)})
+
+    def test_invalid_arguments_are_rejected(self):
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(0, 0, 1)
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(8, 4, 0)
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(8, 8, 1)
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(8, -1, 1)
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(8, None, 1)
+        with self.assertRaises(ValueError):
+            build_worker_rank_mapping(8, 4, 1, num_nodes_waiting=-1)
+
+    def test_failure_recovery_wins_over_waiting_node(self):
+        self.assertFalse(should_start_scale_out(1, "1", 4, True))
+        self.assertFalse(should_start_scale_out(1, "0", 4, True))
+
+    def test_scale_out_requires_an_explicit_configuration(self):
+        self.assertFalse(should_start_scale_out(1, "0", -1, False))
+        self.assertTrue(should_start_scale_out(1, "0", -1, True))
+
+    def test_scale_out_requires_a_waiting_node(self):
+        self.assertFalse(should_start_scale_out(0, "0", -1, True))
+
+    def test_agent_routes_membership_changes_through_the_guard(self):
+        agent_source = (
+            Path(__file__).resolve().parents[1]
+            / "bamboo/project_pactum/agent/api.py"
+        ).read_text(encoding="utf-8")
+        self.assertIn("scale_out_configured = False", agent_source)
+        self.assertNotIn("scale_out_configured = True", agent_source)
+        self.assertIn(
+            "scale_out_requested = should_start_scale_out(", agent_source
+        )
+        self.assertIn(
+            'if scale_out_requested and ready_flag == "1":', agent_source
+        )
+        self.assertNotIn(
+            'if num_nodes_waiting > 0 and ready_flag == "1":', agent_source
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
