+def should_start_scale_out(
+    num_nodes_waiting,
+    reconfigure_flag,
+    failed_node_rank,
+    scale_out_configured,
+):
+    """Return whether a waiting node represents a real scale-out request.
+
+    A node can briefly remain in the rendezvous waiting set while a scale-in
+    is being finalized.  Failure recovery always wins over that observation,
+    and a job that supplied no scale-out configuration must never turn it into
+    a second membership change.
+    """
+    try:
+        waiting = int(num_nodes_waiting)
+    except (TypeError, ValueError):
+        return False
+    if waiting <= 0 or not scale_out_configured:
+        return False
+    if str(reconfigure_flag) == "1":
+        return False
+    if failed_node_rank is None:
+        failed = -1
+    else:
+        try:
+            failed = int(failed_node_rank)
+        except (TypeError, ValueError):
+            return False
+    return failed < 0
