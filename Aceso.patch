@@ -0,0 +1,52 @@
+#!/usr/bin/env bash
+# Smoke test: livepipe-tp for 10 steps, failure injected at iter 3.
+# Verifies: timely escape, full 8->7 recovery, training reaches iter 10.
+# Exits non-zero with the log path to inspect on any failed check.
+set -u
+
+ACESO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../.." && pwd)"
+cd "$ACESO_ROOT"
+
+# Leftover workers from a previous run pollute the rendezvous store and split
+# the reconfiguration barrier (observed as worker_count=13 vs world_size=7).
+if pgrep -f pretrain_gpt.py >/dev/null 2>&1; then
+  echo "[FAIL] 有残留训练进程，先清理再跑：" >&2
+  pgrep -af pretrain_gpt.py >&2
+  exit 1
+fi
+
+TRAIN_ITERS=10 FAILURE_ITER=3 \
+  bash experiments/correctness/run_single_node_8gpu.sh livepipe-tp
+
+RUN_DIR=$(ls -td experiments/correctness/results/correctness-livepipe-tp-seed1234-*/ | head -1)
+echo; echo "== 日志目录: $RUN_DIR"
+
+ok=1
+check() { # check <label> <command...>
+  local label=$1; shift
+  if "$@" >/dev/null 2>&1; then echo "  ✔ $label";
+  else echo "  ✘ $label"; ok=0; fi
+}
+
+check "故障逃逸（catch failed rank: 4）" \
+  grep -q "catch failed rank: 4" "$RUN_DIR"/agent-gpu0.log
+
+n_destroy=$(grep -h "destroyed the process group" "$RUN_DIR"/agent-gpu*.log 2>/dev/null | wc -l)
+[[ $n_destroy -ge 7 ]] && echo "  ✔ 恢复拆组完成（$n_destroy/7）" || { echo "  ✘ 恢复拆组只有 $n_destroy/7"; ok=0; }
+
+check "训练跑满 10 个 iteration" \
+  grep -q "iteration       10/" "$RUN_DIR"/agent-gpu0.log
+
+check "恢复耗时有记录（[TIMER] reconfiguration time）" \
+  grep -q "TIMER..reconfiguration time" "$RUN_DIR"/agent-gpu0.log
+
+n_watchdog=$(grep -c "Watchdog\|Timed out" "$RUN_DIR"/agent-gpu*.log 2>/dev/null | grep -v ':0' | wc -l)
+[[ $n_watchdog -eq 0 ]] && echo "  ✔ 无 watchdog/超时" || { echo "  ✘ 出现 watchdog/超时（$n_watchdog 个日志）"; ok=0; }
+
+echo
+if [[ $ok == 1 ]]; then
+  echo "SMOKE PASS ✅（恢复耗时见: grep TIMER $RUN_DIR/agent-gpu*.log）"
+else
+  echo "SMOKE FAIL ❌ 查日志: $RUN_DIR/agent-gpu*.log" >&2
+  exit 1
+fi
