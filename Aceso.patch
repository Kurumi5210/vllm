diff --git a/experiments/correctness/nccl_transport.sh b/experiments/correctness/nccl_transport.sh
new file mode 100644
index 0000000000000000000000000000000000000000..65cd7b2ea22a1d3478f2c1bdb5b49a5300ab8525
--- /dev/null
+++ b/experiments/correctness/nccl_transport.sh
@@ -0,0 +1,50 @@
+# Shared NCCL transport selection for the correctness experiments.
+#
+# The fault is injected while communication is in flight, and the intra-node
+# transports differ in whether a dead peer can be noticed and cleaned up:
+#
+#   p2p     CUDA IPC / NVLink / PCIe.  Fastest, and what a throughput run
+#           should use.  No peer-failure detection at all: the GPU kernel spins
+#           on a flag in the dead peer's mapped memory, and ncclCommAbort
+#           itself hangs while releasing the IPC handles
+#           (cudaIpcCloseMemHandle, debug.md round 10).
+#   shm     Host shared memory.  Slower than p2p, much faster than socket.
+#           Teardown is munmap/cudaHostUnregister and never touches CUDA IPC,
+#           so the round-10 hang cannot occur; whether the spinning kernel is
+#           actually released still depends on the device-side abort flag being
+#           honoured by this NCCL build.  Default: try this first.
+#   socket  TCP, pinned to loopback for a single node.  Slowest, but a dead
+#           peer closes its socket, so NCCL reports a real error.  Fall back to
+#           this if `shm` still hangs.
+#
+# Select with NCCL_TRANSPORT=p2p|shm|socket.  The rationale and the validation
+# ladder are in docs/review-supplementary-commits.md section 7.
+
+NCCL_TRANSPORT=${NCCL_TRANSPORT:-shm}
+
+case "$NCCL_TRANSPORT" in
+  p2p)
+    export NCCL_P2P_DISABLE=0
+    export NCCL_SHM_DISABLE=0
+    ;;
+  shm)
+    export NCCL_P2P_DISABLE=1
+    export NCCL_SHM_DISABLE=0
+    # IB is a cross-node transport, but with P2P disabled NCCL can fall onto it
+    # for pairs SHM cannot serve.  Keep every pair on the intended transport.
+    export NCCL_IB_DISABLE=${NCCL_IB_DISABLE:-1}
+    ;;
+  socket)
+    export NCCL_P2P_DISABLE=1
+    export NCCL_SHM_DISABLE=1
+    export NCCL_IB_DISABLE=${NCCL_IB_DISABLE:-1}
+    # All eight agents are on this host, so keep NCCL off the physical NIC.
+    export NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:-lo}
+    ;;
+  *)
+    echo "NCCL_TRANSPORT must be one of: p2p, shm, socket (got '$NCCL_TRANSPORT')" >&2
+    exit 2
+    ;;
+esac
+
+export NCCL_TRANSPORT
