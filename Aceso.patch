+        clock.sleep(0.1)
+        self.assertEqual(reader.read(), 4)
+        self.assertEqual(reader.failed_worker_ranks(1), frozenset({4}))
+        # A transient etcd error must not turn "agent 4 failed" into "nobody".
+        handler.fail_gets = 1
