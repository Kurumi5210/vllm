+"""Regression tests for the dev-cx review fixes (CPU only).
+
+See docs/review-supplementary-commits.md for the findings these cover.
+"""
+import ast
+import importlib.util
+from pathlib import Path
+import sys
+import types
+import unittest
+
+
+_REPO = Path(__file__).parents[1]
+sys.modules.setdefault("megatron", types.ModuleType("megatron"))
+sys.modules.setdefault("megatron.data", types.ModuleType("megatron.data"))
+
+
+def _load(name, relative):
+    spec = importlib.util.spec_from_file_location(name, _REPO / relative)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_PROGRESS = sys.modules.get("megatron.data.livepipe_progress") or _load(
+    "megatron.data.livepipe_progress", "megatron/data/livepipe_progress.py"
+)
+_ADJACENT = sys.modules.get("megatron.adjacent_redundancy") or _load(
+    "megatron.adjacent_redundancy", "megatron/adjacent_redundancy.py"
+)
+
+# Other test modules re-load livepipe_progress under the same name, so several
+# RecoveryInvariantError classes can coexist in one session.  Always assert
+# against the class object the module under test actually raises.
+ProgressError = _PROGRESS.RecoveryInvariantError
+PlannerError = _ADJACENT.RecoveryInvariantError
+RuntimeSampleProgress = _PROGRESS.RuntimeSampleProgress
+SLOTS = _ADJACENT.OPTIMIZER_STATE_SLOT_COUNT
+build_adjacent_recovery_plan = _ADJACENT.build_adjacent_recovery_plan
+
+VERSION = 3
+ATTEMPT = 2
+MICROBATCHES = 10
+
+
+def _record(source_rank, prefix, version=VERSION, attempt=ATTEMPT):
+    return {
+        "replica_index": 0,
+        "source_rank": source_rank,
+        "gradient_prefix": prefix,
+        "gradient_version": version,
+        "gradient_attempt": attempt,
+        "weight_version": version,
+        "weight_attempt": attempt,
+        "optimizer_slots": {
+            str(slot): [version, attempt] for slot in range(SLOTS)
+        },
+    }
+
+
+def _inventory(rank, normal_ops=(), prefix=MICROBATCHES, replica_ops=None,
+               version=VERSION, loss_count=MICROBATCHES, gradient_valid=True):
+    return {
+        "holder_rank": rank,
+        "normal": {
+            "parameter_version": version,
+            "attempt_id": ATTEMPT,
+            "completed_microbatches": prefix,
+            "gradient_valid": gradient_valid,
+            "ops": list(normal_ops),
+        },
+        "replica_ops": replica_ops or {},
+        "loss_records": [
+            {"values": {"lm loss": float(i)}, "sample_weight": 4}
+            for i in range(loss_count)
+        ],
+        "optimizer_scalars": {"loss_scale": 128.0},
+    }
+
+
+def _plan(distribution, inventories, version=VERSION):
+    return build_adjacent_recovery_plan(
+        distribution, inventories, optimizer_step_id=version,
+        parameter_version=version, attempt_id=ATTEMPT,
+        expected_microbatches=MICROBATCHES,
+    )
+
+
+class RuntimeProgressFixes(unittest.TestCase):
+    def _configured(self):
+        progress = RuntimeSampleProgress()
+        progress.configure(
+            global_batch_size=40, aggregate_micro_batch_size=4,
+            dataset_size=None, seed=1, shuffle=False, progress_log=None,
+        )
+        return progress
+
+    def test_abort_step_clears_restored_prefixes(self):
+        # fp16-overflow retry: abort_step -> begin_step without reconfigure().
+        progress = self._configured()
+        progress.begin_step(5, 0)
+        progress.configure_op_recovery_prefixes({0: 3})
+        self.assertTrue(progress.has_restored_op_gradients())
+        progress.abort_step(policy="restart-step", finished_microbatches=4)
+        progress.begin_step(5, 0)
+        self.assertEqual(progress.op_recovery_prefixes, {})
+        self.assertFalse(progress.has_restored_op_gradients())
+        progress.begin_backward(0)
+        self.assertTrue(progress.should_accumulate_op(0))
+
+    def test_reconfigure_reinstalls_prefixes_after_abort(self):
+        # The reconfigure path installs the new plan after abort_step and
+        # before begin_step; the reset must not interfere with that order.
+        progress = self._configured()
+        progress.begin_step(5, 0)
+        progress.abort_step(policy="preserve-prefix", finished_microbatches=4)
+        progress.configure_op_recovery_prefixes({0: 3, 1: 0})
+        progress.begin_step(5, 0)
+        self.assertEqual(progress.op_recovery_prefixes, {0: 3, 1: 0})
+        progress.begin_backward(2)
+        self.assertFalse(progress.should_accumulate_op(0))
+        self.assertTrue(progress.should_accumulate_op(1))
+
+    def test_begin_step_validates_before_mutating(self):
+        progress = self._configured()
+        progress.begin_step(5, 0)
+        with self.assertRaises(ProgressError):
+            progress.begin_step(6, 99)
+        self.assertEqual(progress.optimizer_step_id, 5)
+        self.assertEqual(progress.next_microbatch_id, 0)
+
+
+class PlannerFixes(unittest.TestCase):
+    def test_partially_alive_normal_group_is_a_prefix_zero_source(self):
+        # Old rank of the dead lane is -1; the DP partner (new rank 4) is alive
+        # and the replica has not received this step yet (no records).
+        distribution = {0: [[[-1], [4]], [[2], [3]]]}
+        inventories = [
+            _inventory(2), _inventory(3), _inventory(4, [0], prefix=7),
+        ]
+        plan = _plan(distribution, inventories)
+        self.assertEqual(plan.source_replica_index_by_op, {0: 0})
+        self.assertEqual(plan.op_prefixes, {0: 0})
+        self.assertEqual(plan.zero_gradient_ops, (0,))
+        self.assertEqual(plan.start_microbatch_id, 0)
+
+    def test_complete_replica_beats_partially_alive_normal(self):
+        distribution = {0: [[[-1], [4]], [[2], [3]]]}
+        inventories = [
+            _inventory(2, replica_ops={"0": {"records": [_record(-1, 6)]}}),
+            _inventory(3, replica_ops={"0": {"records": [_record(4, 6)]}}),
+            _inventory(4, [0], prefix=7),
+        ]
+        plan = _plan(distribution, inventories)
+        self.assertEqual(plan.source_replica_index_by_op, {0: 1})
+        self.assertEqual(plan.op_prefixes, {0: 6})
+
+    def test_partially_alive_normal_needs_a_complete_tp_lane(self):
+        # A TP group with a dead member cannot serve weights at all.
+        distribution = {0: [[[-1, 4]], [[2, 3]]]}
+        inventories = [_inventory(2), _inventory(3), _inventory(4, [0])]
+        with self.assertRaises(PlannerError):
+            _plan(distribution, inventories)
+
+    def test_two_dead_sources_on_one_holder_must_agree(self):
+        # normal DP4 -> replica DP2: holder 4 aggregates two dead lanes that
+        # both map to -1.  Their prefixes disagree, so the op replays from 0
+        # regardless of the record order.
+        distribution = {0: [[[-1], [-1], [2], [3]], [[4], [5]]]}
+        for order in ((5, 8), (8, 5)):
+            inventories = [
+                _inventory(2, [0]), _inventory(3, [0]),
+                _inventory(4, replica_ops={"0": {"records": [
+                    _record(-1, order[0]), _record(-1, order[1])]}}),
+                _inventory(5, replica_ops={"0": {"records": [
+                    _record(2, 8), _record(3, 8)]}}),
+            ]
+            plan = _plan(distribution, inventories)
+            self.assertEqual(plan.op_prefixes[0], 0, order)
+        inventories[2]["replica_ops"]["0"]["records"] = [
+            _record(-1, 8), _record(-1, 8)]
+        plan = _plan(distribution, inventories)
+        self.assertEqual(plan.source_replica_index_by_op[0], 1)
+        self.assertEqual(plan.op_prefixes[0], 8)
+
+    def test_loss_records_may_differ_by_a_prefix(self):
+        distribution = {0: [[[0], [1]], [[2]]]}
+        inventories = [
+            _inventory(0, [0], prefix=9, loss_count=10),
+            _inventory(1, [0], prefix=9, loss_count=9),
+            _inventory(2, loss_count=0),
+        ]
+        plan = _plan(distribution, inventories)
+        self.assertEqual(len(plan.loss_records), 10)
+        inventories[1]["loss_records"][3]["values"]["lm loss"] = 99.0
+        with self.assertRaises(PlannerError):
+            _plan(distribution, inventories)
+
+    def test_boundary_inventories_never_select_stale_replicas(self):
+        # Iteration-boundary failure: elaceso advertises version step+1 with
+        # an empty prefix; replicas hold the previous version.
+        boundary_version = VERSION + 1
+        distribution = {
+            0: [[[0], [1]], [[2]]],          # normal alive -> version step+1
+            1: [[[-1], [4]], [[3]]],          # partner alive -> prefix 0
+        }
+        inventories = [
+            _inventory(0, [0], prefix=0, version=boundary_version),
+            _inventory(1, [0], prefix=0, version=boundary_version),
+            _inventory(2, version=boundary_version, replica_ops={
+                "0": {"records": [_record(0, 10), _record(1, 10)]}}),
+            _inventory(3, version=boundary_version, replica_ops={
+                "1": {"records": [_record(-1, 10), _record(4, 10)]}}),
+            _inventory(4, [1], prefix=0, version=boundary_version),
+        ]
+        plan = _plan(distribution, inventories, version=boundary_version)
+        self.assertEqual(plan.source_replica_index_by_op, {0: 0, 1: 0})
+        self.assertEqual(plan.op_prefixes, {0: 0, 1: 0})
+        self.assertEqual(plan.parameter_version, boundary_version)
+        # An op whose whole normal group died has no version-correct source.
+        distribution[1] = [[[-1], [-1]], [[3]]]
+        inventories[4]["normal"]["ops"] = []
+        with self.assertRaises(PlannerError):
+            _plan(distribution, inventories, version=boundary_version)
+
+
+
+_FAILURE = sys.modules.get("megatron.livepipe_failure") or _load(
+    "megatron.livepipe_failure", "megatron/livepipe_failure.py"
+)
+
+
+class _FakeHandler:
+    def __init__(self, store=None, fail_gets=0):
+        self.store = dict(store or {})
+        self.fail_gets = fail_gets
+        self.reads = 0
+
+    def get(self, key):
+        self.reads += 1
+        if self.fail_gets > 0:
+            self.fail_gets -= 1
+            raise RuntimeError("etcd unavailable")
+        return self.store.get(key)
+
+    def write(self, key, value):
+        self.store[key] = value
+
+
+class _FakeClock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def __call__(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.now += seconds
+
+
+class FailurePathHelpers(unittest.TestCase):
+    def test_worker_ranks_of_agent(self):
