+    def test_destroy_barrier_rereads_failed_rank_every_poll(self):
+        # The failure is published after the barrier started: the dead rank
+        # must drop out of the expected set instead of blocking everyone.
+        clock = _FakeClock()
+        handler = _FakeHandler({"failed_rank": -1})
+        for rank in (0, 1, 3):
+            handler.write("destroy_barrier_w4_rank{}".format(rank), 1)
+        polls = {"count": 0}
+
+        def sleep(seconds):
+            polls["count"] += 1
+            if polls["count"] == 2:
+                handler.write("failed_rank", 2)
+            clock.sleep(seconds)
+
+        complete, arrived, expected = _FAILURE.etcd_destroy_barrier(
+            handler, rank=0, world_size=4, workers_per_agent=1,
+            timeout_s=10, poll_s=0.5, clock=clock, sleep=sleep,
