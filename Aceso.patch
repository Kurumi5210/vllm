+#!/usr/bin/env bash
+# Inspect the latest livepipe-tp run (and the latest baseline for loss
+# comparison): loss tail, failure-escape lines, recovery progress, timers.
+# Usage: bash check_tp_run.sh [RUN_DIR]   (default: newest livepipe-tp run)
+set -u
+
+RESULTS="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/results"
+
+latest() { ls -td "$RESULTS"/correctness-"$1"-seed1234-*/ 2>/dev/null | head -1; }
+
+TP_DIR=${1:-$(latest livepipe-tp)}
+BASE_DIR=$(latest baseline)
+
+if [[ -z ${TP_DIR} || ! -d ${TP_DIR} ]]; then
+  echo "未找到 livepipe-tp run：$RESULTS/correctness-livepipe-tp-seed1234-*" >&2
+  exit 1
+fi
+echo "== TP run:  $TP_DIR"
+echo "== baseline: ${BASE_DIR:-未找到（loss 对比跳过）}"
+echo
+
+echo "===== 1) loss 尾部对比（验收判据：对齐=修好；恒定偏移=fp16 求和序；单调增长=仍在漂移）====="
+echo "--- livepipe-tp ---"
+grep -h "lm loss" "$TP_DIR"/agent-gpu*.log 2>/dev/null | tail -5 || echo "(无 loss 行)"
+echo "--- baseline ---"
+[[ -n ${BASE_DIR} ]] && grep -h "lm loss" "$BASE_DIR"/agent-gpu*.log 2>/dev/null | tail -5 || true
+echo
+
+echo "===== 2) 故障逃逸（修复后应在故障同一秒打出） ====="
+grep -n "catch failed rank\|redundant send aborted" "$TP_DIR"/agent-gpu*.log 2>/dev/null | tail -10 || echo "(无逃逸记录——若已过故障点则异常)"
+echo
+
+echo "===== 3) 恢复进度（按序应凑齐 7 个 rank） ====="
+grep -h "before destroy barrier" "$TP_DIR"/agent-gpu*.log 2>/dev/null | grep -o "rank [0-9]" | sort | uniq -c
+echo "destroyed the process group: $(grep -h "destroyed the process group" "$TP_DIR"/agent-gpu*.log 2>/dev/null | wc -l) / 7"
+echo
+
+echo "===== 4) 恢复耗时 [TIMER] ====="
+grep -h "\[TIMER\]" "$TP_DIR"/agent-gpu*.log 2>/dev/null | tail -10 || echo "(无 TIMER 行)"
+echo
+
+echo "===== 5) watchdog/超时（应为空；出现说明兜底被触发） ====="
+grep -n "Watchdog\|Timed out" "$TP_DIR"/agent-gpu*.log 2>/dev/null | head -10 || echo "(无)"
