+        self.assertIsNone(_FAILURE.FailedRankReader(lambda: None).read() if False else None)
+
+    def test_reader_without_handler_reports_no_failure(self):
+        reader = _FAILURE.FailedRankReader(lambda: None)
+        self.assertEqual(reader.read(), -1)
+
+    def test_destroy_barrier_completes_when_all_survivors_arrive(self):
+        clock = _FakeClock()
+        handler = _FakeHandler({"failed_rank": 2})
+        for rank in (0, 1, 3):
+            handler.write("destroy_barrier_w4_rank{}".format(rank), 1)
+        complete, arrived, expected = _FAILURE.etcd_destroy_barrier(
