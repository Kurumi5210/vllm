+"""CPU-only contracts for the unsupported sequence-parallel compatibility path."""
+
+import argparse
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+_REPO = Path(__file__).parents[1]
+
+
+def _extract_function(relative_path, function_name, class_name=None, globals_=None):
+    """Compile one function without importing modules that require torch/Apex."""
+    path = _REPO / relative_path
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    body = tree.body
+    if class_name is not None:
+        owner = next(
+            node for node in body
+            if isinstance(node, ast.ClassDef) and node.name == class_name
+        )
+        body = owner.body
+    function = next(
+        node for node in body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name == function_name
+    )
+    module = ast.Module(body=[function], type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = dict(globals_ or {})
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace[function_name]
+
+
+class _MpuStub:
+    def __init__(self, world_size):
+        self.world_size = world_size
+
+    def get_tensor_model_parallel_world_size(self):
+        return self.world_size
+
+    def get_tensor_model_parallel_group(self):
+        return "tp-group"
+
+
+class _NeverIterate:
+    def __iter__(self):
+        raise AssertionError("models must not be inspected when sequence parallelism is off")
+
+
+def _load_allreduce_method(world_size, events):
+    mpu = _MpuStub(world_size)
+
+    def all_reduce(coalesced, group):
+        events.append(("all_reduce", coalesced, group))
+
+    return _extract_function(
+        "megatron/optimizer/optimizer.py",
+        "allreduce_layernorm_grads",
+        class_name="MegatronOptimizer",
+        globals_={
+            "mpu": mpu,
+            "unwrap_model": lambda model, wrappers: model,
+            "torchDDP": type("TorchDDP", (), {}),
+            "LocalDDP": type("LocalDDP", (), {}),
+            "Float16Module": type("Float16Module", (), {}),
+            "_flatten_dense_tensors": lambda grads: tuple(grads),
+            "_unflatten_dense_tensors": lambda coalesced, grads: list(grads),
+            "torch": SimpleNamespace(
+                distributed=SimpleNamespace(all_reduce=all_reduce)
+            ),
+        },
+    )
+
+
+class SequenceParallelArgumentContractTest(unittest.TestCase):
+    def test_distributed_parser_always_defines_disabled_default(self):
+        add_distributed_args = _extract_function(
+            "megatron/arguments.py", "_add_distributed_args"
+        )
+        parser = add_distributed_args(argparse.ArgumentParser())
+        args = parser.parse_args([])
+        self.assertTrue(hasattr(args, "sequence_parallel"))
+        self.assertIs(args.sequence_parallel, False)
+
+
+class LayerNormGradientReductionContractTest(unittest.TestCase):
+    def test_missing_false_and_tp1_true_skip_sequence_parallel_reduction(self):
+        cases = (
+            (1, argparse.Namespace(DDP_impl="local")),
+            (2, argparse.Namespace(DDP_impl="local")),
+            (1, argparse.Namespace(DDP_impl="local", sequence_parallel=False)),
+            (2, argparse.Namespace(DDP_impl="local", sequence_parallel=False)),
+            (1, argparse.Namespace(DDP_impl="local", sequence_parallel=True)),
+        )
+        for world_size, args in cases:
+            with self.subTest(
+                world_size=world_size,
+                sequence_parallel=getattr(args, "sequence_parallel", "missing"),
+            ):
+                events = []
+                method = _load_allreduce_method(world_size, events)
+                method(SimpleNamespace(models=_NeverIterate()), args)
+                self.assertEqual(events, [])
+
+    def test_tp2_true_retains_existing_sequence_parallel_reduction(self):
+        events = []
+        method = _load_allreduce_method(2, events)
+
+        class Buffer:
+            def copy_(self, source):
+                events.append(("copy", source))
+
+        buffer = Buffer()
+        parameter = SimpleNamespace(
+            sequence_parallel=True,
+            main_grad=SimpleNamespace(data=buffer),
+        )
+        model = SimpleNamespace(parameters=lambda: [parameter])
+        optimizer = SimpleNamespace(models=[model])
+        args = argparse.Namespace(DDP_impl="local", sequence_parallel=True)
+
+        method(optimizer, args)
+
+        self.assertEqual(events[0], ("all_reduce", (buffer,), "tp-group"))
+        self.assertEqual(events[1], ("copy", buffer))
+
+
+if __name__ == "__main__":
+    unittest.main()
