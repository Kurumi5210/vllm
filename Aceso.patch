+            and isinstance(node.func.value, ast.Name)
+            and node.func.value.id == "failure_control"
+            and node.func.attr == "failed_rank"
+            for node in ast.walk(functions["_communicate_flexpipe_async"])
+        )
+        self.assertEqual(async_failed_rank_reads, 4)
+
+    def test_checkpoint_script_stays_non_elastic_and_enables_polling(self):
+        script = (_REPO / "experiments/correctness/run_checkpoint_8_to_7.sh").read_text(
+            encoding="utf-8"
+        )
+        self.assertIsNone(re.search(r"(?m)^\s*--elastic(?:\s|$)", script))
+        self.assertIn("--elaceso-no-batch-isend-irecv", script)
+        self.assertIn("--elaceso-failed-iteration", script)
+        self.assertIn("--livepipe-fail-after-backwards", script)
+
+
+if __name__ == "__main__":
+    unittest.main()
