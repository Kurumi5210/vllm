--- /dev/null
+++ b/megatron/livepipe_failure.py
@@ -0,0 +1,117 @@
+"""Torch-free helpers for the mid-iteration failure path.
+
+Everything here talks only to the etcd-backed rendezvous handler (``get`` and
+``write``) and to the clock, so it can run from any thread, inside a process
+whose CUDA streams are jammed on a dead peer, and in CPU unit tests.
+
+Rationale: after a peer dies mid-communication the surviving NCCL kernels
+never complete.  Any CUDA-level synchronization on that device blocks until
+the communicator is aborted, so every decision on the recovery path must be
+taken from CPU-side state.  See docs/review-supplementary-commits.md.
+"""
+
+import time
+
+
+def read_int_key(handler, key, default):
+    """Read an integer etcd key; tolerate missing keys and transient errors."""
+    try:
+        value = handler.get(key)
+    except Exception:
+        return default
+    if value is None:
+        return default
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return default
+
+
+def worker_ranks_of_agent(agent_rank, workers_per_agent):
+    """Worker ranks owned by an elastic agent (``failed_rank`` is an agent rank)."""
+    if agent_rank is None or agent_rank < 0:
+        return frozenset()
+    per_agent = max(1, int(workers_per_agent or 1))
+    return frozenset(agent_rank * per_agent + i for i in range(per_agent))
+
+
+class FailedRankReader:
+    """Throttled reader of the ``failed_rank`` key.
+
+    The redundancy transport asks "is this peer dead?" once per microbatch per
+    peer, so reads are cached for ``min_interval`` seconds.  A transient etcd
+    error keeps the last known value instead of resetting to -1: turning a
+    transient read failure into "nobody failed" is how debug.md round 15 lost
+    a rank.
+    """
+
+    def __init__(self, handler_getter, min_interval=0.05, clock=time.time):
+        self._handler_getter = handler_getter
+        self.min_interval = min_interval
+        self._clock = clock
+        self._value = -1
+        self._stamp = None
+
+    def reset(self):
+        self._value = -1
+        self._stamp = None
+
+    def read(self, force=False):
+        now = self._clock()
+        if not force and self._stamp is not None \
+                and now - self._stamp < self.min_interval:
+            return self._value
+        handler = self._handler_getter()
+        if handler is None:
+            return -1
+        self._value = read_int_key(handler, "failed_rank", self._value)
+        self._stamp = now
+        return self._value
+
+    def failed_worker_ranks(self, workers_per_agent, force=False):
+        return worker_ranks_of_agent(self.read(force=force), workers_per_agent)
+
+
+def etcd_destroy_barrier(handler, rank, world_size, workers_per_agent,
+                         timeout_s=60.0, poll_s=0.2, clock=time.time,
+                         sleep=time.sleep, log=None):
+    """CPU-only replacement for ``torch.distributed.barrier`` before destroy.
+
+    Every surviving rank writes ``destroy_barrier_w{world}_rank{N}`` and polls
+    until all ranks that are not owned by the failed agent have arrived.  The
+    failed rank is re-read on every poll so a transient etcd error cannot
+    freeze a wrong membership list, and the wait is bounded: the barrier only
+    orders the destroy calls, so proceeding after ``timeout_s`` is harmless.
+
+    Returns ``(complete, arrived, expected)``.
+    """
+    prefix = "destroy_barrier_w{}".format(world_size)
+    handler.write("{}_rank{}".format(prefix, rank), 1)
+    deadline = clock() + timeout_s
+    arrived, expected = [], []
+    while True:
+        failed_agent = read_int_key(handler, "failed_rank", -1)
+        dead = worker_ranks_of_agent(failed_agent, workers_per_agent)
+        expected = [r for r in range(world_size) if r not in dead]
+        arrived = [
+            r for r in expected
+            if read_int_key(handler, "{}_rank{}".format(prefix, r), 0) == 1
+        ]
+        if len(arrived) == len(expected):
+            return True, arrived, expected
+        if clock() >= deadline:
+            if log is not None:
+                log("destroy barrier timed out after {}s: {}/{} ranks arrived "
+                    "(missing {})".format(timeout_s, len(arrived), len(expected),
+                                          sorted(set(expected) - set(arrived))))
+            return False, arrived, expected
+        sleep(poll_s)
+
+
+def poll_until(predicate, should_abort, sleep_s=0.0005, sleep=time.sleep):
+    """Spin until ``predicate()`` is true; raise ``should_abort()`` if it returns an exception."""
+    while not predicate():
+        exc = should_abort()
+        if exc is not None:
+            raise exc
+        sleep(sleep_s)
