+class _DistributedStub:
+    def __init__(self, request=None, isend_error=None, batch_error=None):
+        self.request = request
+        self.isend_error = isend_error
+        self.batch_error = batch_error
+
+    def get_rank(self):
+        return 0
+
+    def isend(self, tensor, rank):
+        if self.isend_error is not None:
+            raise self.isend_error
+        return self.request
+
+    def irecv(self, tensor, rank):
+        return self.request
+
+    def P2POp(self, operation, tensor, rank):
+        return operation, tensor, rank
+
+    def batch_isend_irecv(self, operations):
+        if self.batch_error is not None:
+            raise self.batch_error
+        return [self.request for _ in operations]
