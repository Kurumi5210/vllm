+        self.save_proxy_calls = 0
+        self.load_proxy_calls = []
+
+    def state_dict_for_save_checkpoint(self):
+        self.save_proxy_calls += 1
+        return self.module.state_dict_for_save_checkpoint()
+
+    def load_state_dict(self, state_dict, strict=True):
+        self.load_proxy_calls.append((state_dict, strict))
+        self.module.load_state_dict(state_dict, strict=strict)
+
