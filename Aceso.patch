+"""CPU-only contract for the tied-weight gradient reduction.
+
+Every copy of a tied weight (the GPT word embedding lives on both the first
+and the last pipeline stage) must end an optimizer step with the same
+gradient, and that value must be the batch mean.  The 8->7 TP recovery config
+is the only one where the two stages end up with different DP degrees, which
+is what exposed BUG-2026-09-14-014.
+
+The two functions under test are extracted with the AST so that this file
+needs neither Apex nor a distributed backend; ``mpu`` and
+``torch.distributed.all_reduce`` are stubbed and the all-reduce is simulated
+by summing the per-lane results.
+"""
+
+import ast
+from pathlib import Path
+import unittest
+
+import torch
+
+
+_REPO = Path(__file__).parents[1]
+_SOURCE = _REPO / "megatron/training.py"
+_TARGETS = ("_tied_partner_scales", "_tied_gradient_total")
+
+ROOT_OP = 0
+PARTNER_OP = 158
+LOCAL_OP = 7
+
+
+def _load(namespace):
+    tree = ast.parse(_SOURCE.read_text(encoding="utf-8"), filename=str(_SOURCE))
+    wanted = [
+        node for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name in _TARGETS
+    ]
+    assert {node.name for node in wanted} == set(_TARGETS), wanted
+    module = ast.Module(body=wanted, type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(_SOURCE), "exec"), namespace)
+    return namespace["_tied_gradient_total"], namespace["_tied_partner_scales"]
+
+
+class _Op:
+    """One DP lane's view of the tied-weight metadata."""
+
+    def __init__(self, op_index, shared_weights_info):
+        self.op_index = op_index
+        self.shared_weights_info = shared_weights_info
+
+
+def _root_info(root_dp, partner_dp, dp_lane, local_partner=False):
+    """Reproduce initialize_weights_sharing's pairing for the root op."""
+    partners = [PARTNER_OP] + ([LOCAL_OP] if local_partner else [])
+    if partner_dp >= root_dp:
+        paired = list(range(
+            dp_lane * (partner_dp // root_dp),
+            (dp_lane + 1) * (partner_dp // root_dp),
+        ))
+    else:
+        ratio = root_dp // partner_dp
+        paired = [dp_lane // ratio] if dp_lane % ratio == 0 else []
+    return {
+        "word_embeddings": {
+            "root": True,
+            "sharing_with_ops": partners,
+            "sharing_weights_in_same_pipeline_rank": {
+                PARTNER_OP: False, LOCAL_OP: True,
+            },
+            # One entry per paired partner DP lane; TP is 1 in every config
+            # that uses the tied path, so each entry is a single rank.
+            "sharing_weights_with_ranks": {
+                PARTNER_OP: [[lane] for lane in paired],
+            },
+            "tp_split_dim": 0,
+        }
+    }
+
+
+class _TorchStub:
+    """`torch` as the extracted functions see it: only `distributed` is used."""
+
+    def __init__(self, distributed):
+        self.distributed = distributed
+
+
+def _run(root_dp, partner_dp, root_grads, partner_grads, local_grads=None):
+    """Return each root lane's published total for the tied weight."""
+    dp_sizes = {ROOT_OP: root_dp, PARTNER_OP: partner_dp, LOCAL_OP: root_dp}
+    lane_accumulators = []
+
+    class _Mpu:
+        @staticmethod
+        def get_op_dp_size(op_index):
+            return dp_sizes[op_index]
+
+        @staticmethod
+        def get_data_parallel_group(op_index=None):
+            return "dp-group"
+
+    class _Dist:
+        @staticmethod
+        def all_reduce(tensor, group):
+            # Collect instead of reducing in place; once every lane has run we
+            # sum them, which is what a real all-reduce leaves in each lane.
+            lane_accumulators.append(tensor)
+
+    total_fn, _ = _load({"mpu": _Mpu, "torch": _TorchStub(_Dist)})
+
+    published = []
+    for lane in range(root_dp):
+        info = _root_info(root_dp, partner_dp, lane,
+                          local_partner=local_grads is not None)
+        op = _Op(ROOT_OP, info)
+        entries = []
+        if info["word_embeddings"]["sharing_weights_with_ranks"][PARTNER_OP]:
+            paired = info["word_embeddings"]["sharing_weights_with_ranks"][PARTNER_OP]
+            entries.append(sum(partner_grads[lane_id[0]] for lane_id in paired))
+        if local_grads is not None:
+            entries.append(local_grads[lane])
+        published.append(total_fn(op, "word_embeddings", root_grads[lane], entries))
+
+    if root_dp > 1:
+        assert len(lane_accumulators) == root_dp, lane_accumulators
+        reduced = sum(lane_accumulators)
+        published = [reduced.clone() for _ in range(root_dp)]
+    return published
+
+
+def _mean(tensors):
+    return sum(tensors) / len(tensors)
+
+
+class TiedGradientDpContract(unittest.TestCase):
+    def _check(self, root_dp, partner_dp, local=False):
+        torch.manual_seed(root_dp * 10 + partner_dp)
+        root = [torch.randn(4, dtype=torch.float64) for _ in range(root_dp)]
+        partner = [torch.randn(4, dtype=torch.float64) for _ in range(partner_dp)]
+        local_grads = (
+            [torch.randn(4, dtype=torch.float64) for _ in range(root_dp)]
+            if local else None
+        )
+        published = _run(root_dp, partner_dp, root, partner, local_grads)
+
+        expected = _mean(root) + _mean(partner)
+        if local:
+            expected = expected + _mean(local_grads)
+
+        # (1) the batch mean, and (2) identical on every copy: each root lane
+        # keeps this value and sends the same one back to the partner stage.
+        for lane, value in enumerate(published):
+            self.assertTrue(
+                torch.allclose(value, expected),
+                f"root_dp={root_dp} partner_dp={partner_dp} lane={lane}: "
+                f"{value} != {expected}",
+            )
+        for value in published[1:]:
+            self.assertTrue(torch.allclose(value, published[0]))
+
+    def test_equal_dp_degrees(self):
+        self._check(2, 2)
+
+    def test_partner_dp_smaller_is_the_tp_recovery_config(self):
+        # stage 0 stays DP2 while the last stage drops to DP1: root lane 1 is
+        # paired with nothing, and the old code left the two copies unequal.
+        self._check(2, 1)
+
+    def test_partner_dp_larger(self):
+        self._check(1, 2)
+
+    def test_root_dp_one(self):
+        self._check(1, 1)
+
+    def test_wider_dp_ratios(self):
+        self._check(4, 2)
+        self._check(2, 4)
+
+    def test_local_partner_op_on_the_same_stage(self):
+        self._check(2, 1, local=True)
+        self._check(2, 2, local=True)
+
+    def test_scales_match_recv_shared_tensors_entry_count(self):
+        namespace = {}
+        _, scales_fn = _load(namespace)
+
+        class _Mpu:
+            @staticmethod
+            def get_op_dp_size(op_index):
+                return {ROOT_OP: 2, PARTNER_OP: 1, LOCAL_OP: 2}[op_index]
+
+        namespace["mpu"] = _Mpu
+        # An unpaired root lane contributes no remote entry, so no scale.
+        unpaired = _Op(ROOT_OP, _root_info(2, 1, 1))
+        self.assertEqual(scales_fn(unpaired, "word_embeddings"), [])
+        paired = _Op(ROOT_OP, _root_info(2, 1, 0))
+        self.assertEqual(scales_fn(paired, "word_embeddings"), [1.0])
+
+
+if __name__ == "__main__":
+    unittest.main()
