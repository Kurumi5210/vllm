+def _tied_partner_scales(op, key):
+    """Pre-all-reduce scale for each entry recv_shared_tensors returns.
+
+    The order matches that function exactly: local partner ops always append
+    an entry, remote ones only when this root lane is paired with at least one
+    partner DP lane.
+
+    A local partner sits on this rank and this DP lane, so its gradient is a
+    per-lane quantity and shares the 1/dp_size scaling of our own.  A remote
+    partner entry is the sum over the ``lanes`` partner lanes this root lane is
+    paired with, and only ``receivers = min(root_dp, partner_dp)`` of the root
+    lanes hold such an entry; scaling by 1/(lanes * receivers) makes the sum
+    over root lanes equal the partner stage's DP mean for every DP ratio.
+    """
+    info = op.shared_weights_info[key]
+    dp_size = mpu.get_op_dp_size(op.op_index)
+    scales = []
+    for op_index in info["sharing_with_ops"]:
+        if info["sharing_weights_in_same_pipeline_rank"][op_index]:
+            scales.append(1.0 / dp_size)
+            continue
+        lanes = len(info["sharing_weights_with_ranks"].get(op_index, []))
+        if lanes == 0:
+            continue
+        receivers = max(1, min(dp_size, mpu.get_op_dp_size(op_index)))
+        scales.append(1.0 / (lanes * receivers))
+    return scales
