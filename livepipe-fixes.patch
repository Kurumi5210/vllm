+
+class _P2PFailureControl:
+    """Optional failure polling shared by elastic and checkpoint P2P."""
+
+    def __init__(self, handler, notify_ready):
+        self._handler = handler
+        self._notify_ready = notify_ready
+        self._failed_rank_reader = FailedRankReader(lambda: self._handler)
+
+    def failed_rank(self):
+        """Return the failed agent rank, or -1 without a usable handler."""
+        return self._failed_rank_reader.read()
+
+    def notify_ready_to_destroy(self, current_rank):
+        """Best-effort notification used only by online elastic recovery."""
+        if not self._notify_ready or self._handler is None:
+            return False
+        try:
+            self._handler.write(
+                f"ready_to_destroy_rank{current_rank}", "1")
+        except Exception as error:
+            # Diagnostic output is best-effort too: a closed stdout/stderr
+            # must not replace the communication exception being handled.
+            try:
+                print(
+                    f"[P2P][rank {current_rank}] could not publish "
+                    f"ready-to-destroy: {error}",
+                    flush=True,
+                )
+            except Exception:
+                pass
+            return False
+        return True
+
+
+def _get_p2p_failure_control(args):
+    # Project Pactum also supplies a handler to the non-elastic checkpoint
+    # baseline.  ``args.elastic`` controls online reconfiguration, not handler
+    # availability, so non-elastic P2P must retain an already-installed one.
+    if args.elastic:
+        handler = mpu.get_rdzv_handler()
+    else:
+        handler = mpu.maybe_get_rdzv_handler()
+    return _P2PFailureControl(handler, notify_ready=args.elastic)
