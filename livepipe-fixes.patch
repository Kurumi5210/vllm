+"""CPU-only contracts for the unsupported sequence-parallel compatibility path."""
+
+import argparse
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+_REPO = Path(__file__).parents[1]
+
+
+def _extract_function(relative_path, function_name, class_name=None, globals_=None):
+    """Compile one function without importing modules that require torch/Apex."""
+    path = _REPO / relative_path
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    body = tree.body
+    if class_name is not None:
+        owner = next(
+            node for node in body
+            if isinstance(node, ast.ClassDef) and node.name == class_name
+        )
+        body = owner.body
+    function = next(
+        node for node in body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name == function_name
+    )
+    module = ast.Module(body=[function], type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = dict(globals_ or {})
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace[function_name]
+
+
+class _MpuStub:
+    def __init__(self, world_size):
+        self.world_size = world_size
+
+    def get_tensor_model_parallel_world_size(self):
+        return self.world_size
+
+    def get_tensor_model_parallel_group(self):
+        return "tp-group"
+
+
+class _NeverIterate:
+    def __iter__(self):
+        raise AssertionError("models must not be inspected when sequence parallelism is off")
+
+
+def _load_allreduce_method(world_size, events):
+    mpu = _MpuStub(world_size)
+
+    def all_reduce(coalesced, group):
+        events.append(("all_reduce", coalesced, group))
+
+    return _extract_function(
