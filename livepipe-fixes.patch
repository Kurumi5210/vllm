+"""CPU-only contracts for optional P2P rendezvous failure polling."""
+
+import argparse
+import ast
+import importlib.util
+from pathlib import Path
+import re
+import sys
+from types import SimpleNamespace
+import unittest
+
+
+_REPO = Path(__file__).parents[1]
+
+
+def _load_module(name, relative_path):
+    spec = importlib.util.spec_from_file_location(name, _REPO / relative_path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+_FAILURE = _load_module(
+    "p2p_failure_control_test_helpers", "megatron/livepipe_failure.py"
+)
+
+
+def _extract_definitions(relative_path, names, globals_=None):
+    """Compile selected top-level definitions without importing torch/Apex."""
+    path = _REPO / relative_path
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    selected = [
+        node for node in tree.body
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef))
+        and node.name in names
+    ]
+    found = {node.name for node in selected}
+    if found != set(names):
+        raise AssertionError("missing definitions: {}".format(set(names) - found))
+    module = ast.Module(body=selected, type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = dict(globals_ or {})
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace
+
+
+class _Handler:
+    def __init__(self, failed_rank=-1, get_error=None, write_error=None):
+        self.failed_rank = failed_rank
+        self.get_error = get_error
+        self.write_error = write_error
+        self.get_calls = 0
+        self.writes = []
+
+    def get(self, key):
+        self.get_calls += 1
+        if self.get_error is not None:
+            raise self.get_error
+        if key != "failed_rank":
+            raise AssertionError("unexpected key {}".format(key))
+        return self.failed_rank
+
+    def write(self, key, value):
+        if self.write_error is not None:
+            raise self.write_error
+        self.writes.append((key, value))
+
+
+class _MpuStub:
+    def __init__(self, strict_handler=None, optional_handler=None):
+        self.strict_handler = strict_handler
+        self.optional_handler = optional_handler
+        self.strict_calls = 0
+        self.optional_calls = 0
+
+    def get_rdzv_handler(self):
+        self.strict_calls += 1
+        if self.strict_handler is None:
+            raise AssertionError("elastic mode requires a rendezvous handler")
+        return self.strict_handler
+
+    def maybe_get_rdzv_handler(self):
+        self.optional_calls += 1
+        return self.optional_handler
+
+
+def _p2p_definitions(mpu, print_=print):
+    return _extract_definitions(
+        "megatron/p2p_communication.py",
+        {"_P2PFailureControl", "_get_p2p_failure_control"},
+        globals_={
+            "FailedRankReader": _FAILURE.FailedRankReader,
+            "mpu": mpu,
+            "print": print_,
+        },
+    )
+
+
+class _NextStageError(Exception):
+    pass
+
+
+class _PrevStageError(Exception):
+    pass
+
+
+class _CurStageError(Exception):
+    pass
+
+
+class _NoGrad:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        return False
+
+
+class _Request:
+    def __init__(self, completed):
+        self.completed = list(completed)
+
+    def is_completed(self):
+        if len(self.completed) > 1:
+            return self.completed.pop(0)
+        return self.completed[0]
+
+
+class _DistributedStub:
+    def __init__(self, request=None, isend_error=None, batch_error=None):
+        self.request = request
+        self.isend_error = isend_error
+        self.batch_error = batch_error
+
+    def get_rank(self):
+        return 0
+
+    def isend(self, tensor, rank):
+        if self.isend_error is not None:
+            raise self.isend_error
+        return self.request
+
+    def irecv(self, tensor, rank):
+        return self.request
+
+    def P2POp(self, operation, tensor, rank):
+        return operation, tensor, rank
+
+    def batch_isend_irecv(self, operations):
+        if self.batch_error is not None:
+            raise self.batch_error
+        return [self.request for _ in operations]
+
+
+class _RuntimeMpuStub(_MpuStub):
+    def get_stage_comm_recv_ranks(self):
+        return []
+
+    def get_stage_comm_send_ranks(self):
+        return [1]
+
+    def get_send_info(self, forward):
+        return {"tensors": {"payload": {}}}
+
+
+def _runtime_p2p_definitions(mpu, args, distributed):
+    torch = SimpleNamespace(
+        distributed=distributed,
+        no_grad=lambda: _NoGrad(),
+        cuda=SimpleNamespace(synchronize=lambda: None),
