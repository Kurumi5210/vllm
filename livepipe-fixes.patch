+            "FailedRankReader": _FAILURE.FailedRankReader,
+            "mpu": mpu,
+            "get_args": lambda: args,
+            "get_timers": lambda: None,
+            "torch": torch,
+            "DEBUG_COMMUNICATE": False,
+            "EXTRA_TENSOR_TRANSFER": True,
+            "_partition": lambda tensor, info, forward: [tensor],
+            "_create_recv_placeholder": lambda forward: {},
+            "_reshape": lambda tensors, info, forward: ({}, {}),
+            "sync_thread": lambda: None,
+            "NextStageException": _NextStageError,
+            "PrevStageException": _PrevStageError,
+            "CurStageException": _CurStageError,
+            "print": lambda *args, **kwargs: None,
+        },
+    )
+
+
+class P2PFailureControlTest(unittest.TestCase):
+    def test_non_elastic_checkpoint_retains_installed_handler(self):
+        handler = _Handler(failed_rank="4")
+        mpu = _MpuStub(optional_handler=handler)
