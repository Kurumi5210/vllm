+"""CPU-only contracts for checkpoint model container normalization."""
+
+import ast
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+
+_REPO_ROOT = Path(__file__).resolve().parents[1]
+_CHECKPOINTING_PATH = _REPO_ROOT / "megatron" / "checkpointing.py"
+_TARGET_DEFINITIONS = {
+    "_checkpoint_model_list",
+    "save_checkpoint",
+    "load_checkpoint",
+    "load_biencoder_checkpoint",
+}
+
+
+def _checkpoint_ast():
+    return ast.parse(_CHECKPOINTING_PATH.read_text(encoding="utf-8"))
+
+
+def _load_checkpoint_definitions(namespace):
+    tree = _checkpoint_ast()
+    definitions = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name in _TARGET_DEFINITIONS
+    ]
+    found = {node.name for node in definitions}
+    if found != _TARGET_DEFINITIONS:
+        raise AssertionError(
+            "missing checkpoint definitions: {}".format(
+                sorted(_TARGET_DEFINITIONS - found)
+            )
+        )
+    module = ast.Module(body=definitions, type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(_CHECKPOINTING_PATH), "exec"), namespace)
+    return namespace
+
+
+class _Model:
+    def __init__(self, name):
+        self.name = name
+        self.save_calls = 0
+        self.load_calls = []
+
+    def state_dict_for_save_checkpoint(self):
+        self.save_calls += 1
+        return {"name": self.name}
+
+    def load_state_dict(self, state_dict, strict=True):
+        self.load_calls.append((state_dict, strict))
+
+
+class _TorchDDPLike:
+    def __init__(self, module):
+        self.module = module
+
+
+class _LocalDDPLike:
+    def __init__(self, module):
+        self.module = module
+        self.save_proxy_calls = 0
+        self.load_proxy_calls = []
+
+    def state_dict_for_save_checkpoint(self):
+        self.save_proxy_calls += 1
+        return self.module.state_dict_for_save_checkpoint()
+
+    def load_state_dict(self, state_dict, strict=True):
+        self.load_proxy_calls.append((state_dict, strict))
+        self.module.load_state_dict(state_dict, strict=strict)
+
+
+class _Utils:
+    def __init__(self):
+        self.inputs = []
+
+    def unwrap_model(self, models):
+        self.inputs.append(models)
+        return [
+            model.module if isinstance(model, _TorchDDPLike) else model
+            for model in models
+        ]
+
+
+class _Distributed:
+    def __init__(self, initialized=False):
+        self.initialized = initialized
+        self.barrier_calls = 0
+
+    def is_initialized(self):
+        return self.initialized
+
+    def barrier(self):
+        self.barrier_calls += 1
+
+    @staticmethod
+    def get_rank():
+        return 0
+
+
+class _Torch:
+    def __init__(self):
+        self.distributed = _Distributed()
+        self.saved = []
+        self.load_result = None
+
+    def save(self, state_dict, checkpoint_name):
+        self.saved.append((state_dict, checkpoint_name))
+
+    def load(self, checkpoint_name, map_location=None):
+        return self.load_result
+
+
+class _MPU:
+    def __init__(self):
+        self.virtual_ranks = []
+
+    @staticmethod
+    def get_data_parallel_rank():
+        return 0
+
+    def set_virtual_pipeline_model_parallel_rank(self, rank):
+        self.virtual_ranks.append(rank)
+
+
+class _Runtime:
+    def __init__(self, args):
+        self.args = args
+        self.torch = _Torch()
+        self.mpu = _MPU()
+        self.utils = _Utils()
+        self.checkpoint_version = None
+        self.fixed_models = None
+        self.namespace = _load_checkpoint_definitions(
+            {
+                "os": os,
+                "sys": sys,
+                "torch": self.torch,
+                "mpu": self.mpu,
+                "utils": self.utils,
+                "get_args": lambda: self.args,
+                "print_rank_0": lambda *args, **kwargs: None,
+                "get_checkpoint_name": self.get_checkpoint_name,
+                "get_checkpoint_tracker_filename": (
+                    self.get_checkpoint_tracker_filename
+                ),
+                "ensure_directory_exists": self.ensure_directory_exists,
+                "set_checkpoint_version": self.set_checkpoint_version,
+                "get_checkpoint_version": lambda: self.checkpoint_version,
+                "check_checkpoint_args": lambda checkpoint_args: None,
+                "update_num_microbatches": lambda consumed_samples: None,
+                "fix_query_key_value_ordering": self.fix_models,
+            }
+        )
+
+    @staticmethod
+    def get_checkpoint_name(directory, iteration, release=False):
+        suffix = "release" if release else "iter_{:07d}".format(iteration)
+        return str(Path(directory) / (suffix + ".pt"))
+
+    @staticmethod
+    def get_checkpoint_tracker_filename(directory):
+        return str(Path(directory) / "latest_checkpointed_iteration.txt")
+
+    @staticmethod
+    def ensure_directory_exists(filename):
+        Path(filename).parent.mkdir(parents=True, exist_ok=True)
+
+    def set_checkpoint_version(self, version):
+        self.checkpoint_version = version
+
+    def fix_models(self, models, checkpoint_version):
+        self.fixed_models = (models, checkpoint_version)
+
+
+def _save_args(directory):
+    return SimpleNamespace(
+        save=str(directory),
+        no_save_optim=True,
+        no_save_rng=True,
+    )
+
+
+def _load_args(directory):
+    return SimpleNamespace(
+        load=str(directory),
+        finetune=False,
+        no_load_optim=True,
+        no_load_rng=True,
+        consumed_train_samples=0,
+        consumed_valid_samples=0,
+    )
+
+
+class CheckpointModelContractTest(unittest.TestCase):
+    def test_normalizer_wraps_single_model_and_rejects_empty_list(self):
+        with tempfile.TemporaryDirectory() as directory:
