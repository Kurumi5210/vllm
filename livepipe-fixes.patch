+        self.assertEqual(handler.writes, [("ready_to_destroy_rank6", "1")])
+
+    def test_transient_read_error_means_no_published_failure(self):
+        handler = _Handler(get_error=RuntimeError("etcd unavailable"))
+        definitions = _p2p_definitions(_MpuStub())
+        control = definitions["_P2PFailureControl"](
+            handler, notify_ready=False
+        )
+
+        self.assertEqual(control.failed_rank(), -1)
+        self.assertEqual(handler.get_calls, 1)
+
+    def test_notification_error_cannot_replace_communication_error(self):
+        handler = _Handler(write_error=RuntimeError("etcd unavailable"))
+        definitions = _p2p_definitions(_MpuStub())
