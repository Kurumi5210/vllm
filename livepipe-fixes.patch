+        self.assertEqual(mpu.strict_calls, 0)
+        self.assertFalse(control.notify_ready_to_destroy(3))
+        self.assertEqual(handler.writes, [])
+
+    def test_non_elastic_without_handler_is_safe(self):
+        mpu = _MpuStub(optional_handler=None)
+        definitions = _p2p_definitions(mpu)
+        control = definitions["_get_p2p_failure_control"](
+            argparse.Namespace(elastic=False)
+        )
